     <property name="styleSheet">
      <string notr="true">QTableWidget {
    background-color: #F5F0FF;   /* Violet très très clair */
    border: 2px solid #1034A6;
    border-radius: 12px;
    gridline-color: white;       /* Lignes blanches */
}

QHeaderView::section {
    background-color: #1034A6;   /* Bleu foncé */
    color: white;                /* Texte blanc */
    border: none;
    padding: 6px;
    font-weight: bold;
}

QHeaderView::section:first {
    border-top-left-radius: 8px;
}

QHeaderView::section:last {
    border-top-right-radius: 8px;
}

QTableWidget::item {
    border: 1px solid white;     /* Bordures blanches entre cellules */
}</string>
