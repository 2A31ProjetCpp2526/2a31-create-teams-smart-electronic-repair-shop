     <property name="styleSheet">
      <string notr="true">QGroupBox {
    background-color: #FFFFFF;
    border: 10px solid #9305F2;   /* Violet clair */
    border-radius: 15px;         /* Coins arrondis */
    margin-top: 30px;            /* Décalage du titre */
    padding: 12px;
    color: #48038C;              /* Couleur du texte interne */
    font-weight: bold;
}

/* Titre du QGroupBox */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;   /* Centré en haut */
    padding: 15px 35px;
    background-color: white;
    color: #48038C;
    border-radius: 10px;
    font-weight: bold;
}</string>
